{
  "name": "dsh-finance-workbench",
  "version": "2.5.0",
  "description": "WorkBuddy 与 DeepSeek Harness 可视化财务工作台 — 20 个模块、异常闭环和 25 个 AI 工作流",
  "license": "MIT",
  "homepage": "https://github.com/feng-liu-1994/workbuddy-finance-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feng-liu-1994/workbuddy-finance-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/feng-liu-1994/workbuddy-finance-workbench/issues"
  },
  "keywords": [
    "workbuddy",
    "deepseek-harness",
    "finance",
    "accounting",
    "ai-agent",
    "workflow"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "agents",
    "workbuddy",
    ".codebuddy-plugin",
    ".mcp.json",
    "scripts/install-workbuddy-app.sh",
    "scripts/install-workbuddy-app.ps1",
    "安装 WorkBuddy 财务工作台.command",
    "卸载 WorkBuddy 财务工作台.command",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs && node scripts/build-workbuddy-app.mjs",
    "catalog": "node scripts/generate-agent-catalog.mjs",
    "test": "node --test test/*.test.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "check": "npm run catalog && npm run test && npm run build && npm run security:scan",
    "verify:release": "bash scripts/verify-release.sh",
    "package:release": "bash scripts/package-release.sh",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "esbuild": "^0.28.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "preact": "^10.29.8"
  }
}
